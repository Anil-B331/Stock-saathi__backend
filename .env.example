# StockSathi backend env

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Database ---
# Locally:  postgresql://postgres:postgres@localhost:5432/stocksaathi
# On Railway: use the DATABASE_URL provided by the Railway Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stocksaathi

# --- Auth ---
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# --- CORS (optional) ---
# Comma-separated origins, e.g. https://stocksaathi-admin.web.app
# Leave blank to allow all origins.
CORS_ORIGINS=
